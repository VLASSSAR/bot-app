TELEGRAM_BOT_TOKEN=
# Comma-separated numeric Telegram user IDs. Empty = only /whoami works.
ALLOWED_USER_IDS=
# Identify the collector; replace the contact with yours if desired.
HTTP_USER_AGENT=bot-app/0.1 (+https://github.com/VLASSSAR/bot-app)
# Only used when /hh on. Optional HH application token if required.
HH_ACCESS_TOKEN=
DATABASE_PATH=data/bot.sqlite3
BOT_TIMEZONE=Asia/Novosibirsk
